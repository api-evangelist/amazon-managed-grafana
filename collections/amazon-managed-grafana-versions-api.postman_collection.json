          "name": "Amazon Managed Grafana List Versions",
          "request": {
            "name": "Amazon Managed Grafana List Versions",
            "description": {
              "content": "Lists available versions of Grafana. These are available when calling <code>CreateWorkspace</code>. Optionally, include a workspace to list the versions to which it can be upgraded.",
              "type": "text/plain"
            },
            "url": {
